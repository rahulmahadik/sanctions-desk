# Copy to .env and fill in your own values. Never commit .env.
# With SAMPLE_MODE=true nothing else is needed: no Zetaris, no Nightshift, no keys.

# --- Run mode -------------------------------------------------------------
# true: saved data and a labelled stand-in model, no services needed. Set false to use live Zetaris and Nightshift.
SAMPLE_MODE=true
# Cloud privacy mode: off (default) or pseudonymise (names, identifiers, dates of birth, addresses and countries
# of the case are replaced by tokens in every cloud prompt and mapped back on this machine).
PRIVACY_MODE=off

# --- Zetaris (the only data path) ------------------------------------------
# Addresses below are for running on this machine. From inside a Docker container, the services on the host are
# reached at http://host.docker.internal:<port> (for example http://host.docker.internal:8888/api/v1.0,
# http://host.docker.internal:8088/v1 and http://host.docker.internal:11434/v1). docker-compose.yml already sets
# these three for the api service and adds `extra_hosts: host.docker.internal:host-gateway`, which makes the name
# work on Linux too.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
# The Zetaris web interface; only the user setup tool uses it.
ZETARIS_UI_URL=http://localhost:3000
# Admin key: setup tooling and the labelled fallback only.
ZETARIS_API_KEY=your-zetaris-admin-api-key
# One API token per runtime user (see docs/ZETARIS.md).
ZETARIS_TOKEN_EVIDENCE=your-token-for-agent_evidence
ZETARIS_TOKEN_REVIEWER=your-token-for-agent_reviewer
ZETARIS_TOKEN_EVAL=your-token-for-agent_eval
# Optional per-step identities: each role is granted only that step's tables. Without one, the step reads as evidence.
ZETARIS_TOKEN_OWNERSHIP=
ZETARIS_TOKEN_CRITIC=
ZETARIS_TOKEN_MEMORY=
ZETARIS_TOKEN_DOCUMENT=
ZETARIS_TOKEN_RESCREEN=

# --- Meterless Nightshift (model runtime) ----------------------------------
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_APP_ID=sanctions-desk
# A separate app id keeps the runtime's answer cache apart for evaluation runs.
METERLESS_EVAL_APP_ID=sanctions-desk-eval
# Pinned modes per lane. meterless/auto is rejected.
METERLESS_MODEL_FAST=meterless/fast
METERLESS_MODEL_DEEP=meterless/deep
METERLESS_MODEL_JUDGE=meterless/judge
# Comma-separated base64 Ed25519 keys; `npm run receipt:pubkey` prints the runtime's key.
# App identities for reasoning and for the safety guard. In the Nightshift cockpit, bind the guard identity to
# "local" and the reasoning identity to "deep" (see docs/MODELS.md). Leave as they are if you do not.
METERLESS_APP_REASONING=sanctions-desk-reasoning
METERLESS_APP_GUARD=sanctions-desk-guard
METERLESS_RECEIPT_PUBLIC_KEY=
# Folder with the engine conformance runners (npm run test:engines).
METERLESS_ENGINES_DIR=../meterless-engines

# --- Ollama (backup provider) ----------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=nemotron-3.5-lightning:30b

# --- API server ------------------------------------------------------------
# 127.0.0.1 keeps the API on this machine. The container image and docker compose set HOST=0.0.0.0 inside the
# container; the published port is still bound to 127.0.0.1 unless BIND_ADDRESS says otherwise.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
LOG_DIR=logs
# true: print one short readable line per trace event to stdout (time, agent, action, status, summary, receipt id)
# instead of the JSON line. The trace file always gets the full JSON. `npm run case` turns it on unless set to false.
TRACE_STDOUT_PRETTY=false
# Browser origins allowed to call the API (the review desk interface), comma separated.
WEB_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Serve the API description and Swagger UI at /docs.
DOCS_ENABLED=true
# Who may call the API: auto (tokens required live, demo users in sample mode), on, demo, off (tests only).
AUTH_MODE=auto
# How often one caller (the signed-in user, or the address when there is no sign-in) may change things or start a
# review, per window. Reads and /health are never limited. Above a limit the answer is 429 with Retry-After.
# RATE_LIMIT_ENABLED=false is for tests and in-process tools only.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
# Requests per window to any route that is not a read.
RATE_LIMIT_WRITES=60
# Requests per window to POST /run and POST /policy/whatif (also counted as writes).
RATE_LIMIT_REVIEWS=10
# Reviews (POST /run) running at once, across all callers. One more is refused, not queued.
RATE_LIMIT_REVIEWS_IN_FLIGHT=4
# JSON file with the users, their roles and the SHA-256 of each token. Keep it outside the repository.
# Create one with: npm run users:add -- --file <path> --id <name> --role <analyst|approver|policy_admin|viewer>
DESK_USERS_FILE=
# Folder for the records written after a person approves a recommendation (a local outbox; nothing is sent).
DESK_OUTBOX_DIR=outbox
# Ed25519 private key (PEM) outside the repository, and its public key (base64). Without a key, records are hash-sealed.
# Create a pair with: npm run actions:keygen
DESK_SIGNING_KEY_FILE=
DESK_SIGNING_PUBLIC_KEY=
# Optional, off by default: Scout Intent checks each next-action record before it is sealed
DESK_SCOUT_INTENT=false

# --- Review desk interface (apps/web) --------------------------------------
# Where the browser reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Synthetic bank (docker compose profile "data") -------------------------
BANKDB_ADMIN_PASSWORD=choose-a-password
BANKDB_READER_PASSWORD=choose-another-password
# The bank database address as Zetaris reaches it (a JDBC address: driver, host, port and database name; with the
# compose setup the host is bankdb, the port 5432 and the database bank). Used only by the Zetaris setup scripts.
BANKDB_JDBC_URL=
PAYMENTS_API_KEY=choose-a-key
# Used by the payments service when run outside Docker.
PAYMENTS_FILE=data/synthetic/payment.json

# --- MCP server (npm run mcp) ----------------------------------------------
# Where the desk API listens, and how the MCP server identifies itself: a token, or a demo user in sample mode.
DESK_API_URL=http://localhost:8000
DESK_TOKEN=
DESK_DEMO_USER=

# --- Tests and checks ------------------------------------------------------
LIVE_TESTS=0
ZETARIS_CHECK_CONTAINER=zetaris-driver-1
