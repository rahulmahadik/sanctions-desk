.env
.env.*
# Local editor-assistant instructions and settings: never committed.
CLAUDE.md
.claude/
!.env.example
.venv/
__pycache__/
logs/
*.pem
*.key
# Private scratch: run logs, notes. Never commit.
internal/

# Node / TypeScript
node_modules/
dist/
coverage/
*.tsbuildinfo

# Raw and normalised list downloads (large, reproducible with npm run data:fetch)
data/raw/
data/normalised/

# This machine's non-secret settings (for example a pinned receipt public key)
config/local.json
.local/
.next/
apps/web/next-env.d.ts

# Editor, OS and tool leftovers
.DS_Store
.vscode/
.idea/
*.log
npm-debug.log*
.eslintcache
.turbo/
test-results/
playwright-report/
tmp/
*.tgz

# Built by npm run site:build (the API docs site): generated from the code and docs/media, never stale in git
site/openapi.json
site/media/
# The "Recorded runs" pages, replayed from the committed run exports by the same command
site/runs/
site/receipts/

# Runtime output that is not part of the project
action-outbox/
outbox/
.runtime/
