  "zetaris": {
    "restUrl": "http://localhost:8888/api/v1.0",
    "orgId": "1",
    "requestTimeoutMs": 30000,
    "namespace": "lightning.metastore.sanctions",
    "usl": "screening_usl",
    "maxRows": 200,
    "fileStore": {
      "container": "zetaris-driver-1",
      "database": "sanctions_lists",
      "folder": "sanctions"
    }
  },
  "nightshift": {
    "baseUrl": "http://127.0.0.1:8088/v1",
    "appId": "sanctions-desk",
    "scope": "user",
    "requestTimeoutMs": 90000,
    "models": {
      "fast": "meterless/fast",
      "deep": "meterless/deep",
      "judge": "meterless/judge"
    },
    "receiptPublicKeys": ["00OsSOXGbDitkESZueIJqDPdf9bXAvyrL+8cYDbY6II="],
    "evalAppId": "sanctions-desk-eval",
    "apps": {
      "reasoning": "sanctions-desk-reasoning",
      "guard": "sanctions-desk-guard"
    },
    "rateLimit": {
      "retries": 3,
      "baseDelayMs": 3000
    }
  },
  "ollama": {
    "baseUrl": "http://localhost:11434/v1",
