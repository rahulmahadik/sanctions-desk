{
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "bodyLimitBytes": 1048576,
    "shutdownTimeoutMs": 10000
  },
  "logging": {
    "level": "info",
    "dir": "logs",
    "stdout": true
  },
  "sampleMode": false,
  "zetaris": {
    "restUrl": "http://localhost:8888/api/v1.0",
    "orgId": "1",
    "requestTimeoutMs": 30000,
    "namespace": "lightning.metastore.sanctions",
    "usl": "screening_usl",
    "maxRows": 200,
    "fileStore": {
      "container": "zetaris-driver-1",
      "database": "sanctions_lists",
      "folder": "sanctions"
    }
  },
  "nightshift": {
    "baseUrl": "http://127.0.0.1:8088/v1",
    "appId": "sanctions-desk",
    "scope": "user",
    "requestTimeoutMs": 90000,
    "models": {
      "fast": "meterless/fast",
      "deep": "meterless/deep",
      "judge": "meterless/judge"
    },
    "receiptPublicKeys": [],
    "evalAppId": "sanctions-desk-eval"
  },
  "ollama": {
    "baseUrl": "http://localhost:11434/v1",
    "model": "nemotron-3.5-lightning:30b",
    "requestTimeoutMs": 90000
  },
  "limits": {
    "criticMaxRounds": 3,
    "healthProbeTimeoutMs": 3000
  },
  "events": {
    "replayLimit": 2000,
    "maxRuns": 200
  },
  "policy": {
    "file": "config/policy.default.json"
  }
}
