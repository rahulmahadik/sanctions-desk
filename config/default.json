  "events": {
    "replayLimit": 2000,
    "maxRuns": 200
  },
  "policy": {
    "file": "config/policy.default.json"
  },
  "sampleCache": "data/sample/query-cache.json",
  "costs": {
    "currency": "USD",
    "cloudInputPerMillionTokens": 0.5,
    "cloudOutputPerMillionTokens": 1.5,
