{
  "version": 3,
  "name": "Default screening policy",
  "description": "Baseline behaviour of the sanctions review desk. The jurisdiction list is a configurable example, not a complete or current list. Changes go through a reviewed, four-eyes publish.",
  "lists": {
    "enabled": ["OFAC", "UN"],
    "weights": {
      "OFAC": 1,
      "UN": 0.9,
      "EU": 0.9,
      "UK": 0.9
    }
  },
  "matching": {
    "nameSimilarityThreshold": 0.85,
    "autoCloseCeiling": 0.6,
    "strongIdentifierFields": ["dob", "nationality", "id_number", "passport_number"],
    "minStrongIdentifierMatches": 2
  },
  "ownership": {
    "thresholdPercent": 50,
    "aggregate": true,
    "maxChainDepth": 5,
    "onLimitReached": "escalate"
  },
  "jurisdictions": [
    {
      "country": "CU",
      "action": "escalate",
      "note": "Example entry. Verify against the current OFAC sanctions programs before relying on it; program status changes over time (for example Syria in 2025).",
      "keywords": ["Cuba", "Havana"]
    },
    {
      "country": "IR",
      "action": "escalate",
      "note": "Example entry. Verify against the current OFAC sanctions programs before relying on it; program status changes over time (for example Syria in 2025).",
      "keywords": ["Iran", "Tehran"]
    },
    {
      "country": "KP",
      "action": "escalate",
      "note": "Example entry. Verify against the current OFAC sanctions programs before relying on it; program status changes over time (for example Syria in 2025).",
      "keywords": ["North Korea", "DPRK", "Pyongyang"]
    }
  ],
  "automation": {
    "autoClose": true,
    "autoEscalate": true,
    "autoBlock": false,
    "messageCustomers": false,
    "dataAccess": "read_only",
    "blockApprovalsRequired": 2
  },
  "critic": {
    "maxRounds": 3,
    "confidenceFloorForClose": 0.7,
    "abstainOnInvalidData": true
  },
  "evidenceStandard": {
    "definition": "false_positive@2",
    "requireCheckReference": true,
    "requireDocumentNumber": true,
    "requireDate": true,
    "requireNamedCounterpartyForPayments": true
  },
  "models": {
    "triage": {
      "model": "fast",
      "thinking": "off",
      "timeoutMs": 60000
    },
    "evidence": {
      "model": "fast",
      "thinking": "off",
      "timeoutMs": 60000
    },
    "matching": {
      "model": "fast",
      "thinking": "off",
      "timeoutMs": 60000
    },
    "ownership": {
      "model": "deep",
      "thinking": {
        "budgetTokens": 500
      },
      "timeoutMs": 90000
    },
    "decision": {
      "model": "deep",
      "thinking": {
        "budgetTokens": 500
      },
      "timeoutMs": 90000
    },
    "critic": {
      "model": "judge",
      "thinking": {
        "budgetTokens": 400
      },
      "timeoutMs": 90000
    },
    "challenger": {
      "model": "deep",
      "thinking": {
        "budgetTokens": 500
      },
      "timeoutMs": 90000
    },
    "policy_guard": {
      "model": "fast",
      "thinking": "off",
      "timeoutMs": 60000
    },
    "reporter": {
      "model": "fast",
      "thinking": "off",
      "timeoutMs": 60000
    }
  },
  "masking": {
    "triage": "role_evidence_agent",
    "evidence": "role_evidence_agent",
    "matching": "role_evidence_agent",
    "ownership": "role_evidence_agent",
    "decision": "role_evidence_agent",
    "critic": "role_evidence_agent",
    "policy_guard": "role_evidence_agent",
    "reporter": "role_evidence_agent",
    "challenger": "role_evidence_agent"
  },
  "agentAccess": {
    "triage": {
      "tables": [],
      "denyColumns": ["id_number"]
    },
    "evidence": {
      "tables": [
        "business_definition",
        "list_entry",
        "list_alias",
        "list_dob",
        "list_country",
        "list_identifier",
        "customer",
        "customer_identifier",
        "customer_alias",
        "account",
        "beneficial_owner",
        "payment",
        "alert",
        "disposition"
      ],
      "denyColumns": []
    },
    "matching": {
      "tables": [],
      "denyColumns": ["id_number"]
    },
    "ownership": {
      "tables": ["beneficial_owner"],
      "denyColumns": ["id_number"]
    },
    "decision": {
      "tables": [],
      "denyColumns": ["id_number"]
    },
    "critic": {
      "tables": [
        "business_definition",
        "list_entry",
        "list_alias",
        "list_dob",
        "list_country",
        "list_identifier",
        "customer",
        "customer_identifier",
        "beneficial_owner",
        "payment",
        "alert"
      ],
      "denyColumns": ["id_number"]
    },
    "policy_guard": {
      "tables": [],
      "denyColumns": ["id_number"]
    },
    "reporter": {
      "tables": [],
      "denyColumns": ["id_number"]
    },
    "challenger": {
      "tables": [],
      "denyColumns": ["id_number"]
    }
  },
  "guards": {
    "tippingOffPolicy": "Never write or approve any text for a customer or third party that states or implies that they are subject to sanctions screening, an investigation, a suspicious activity report or a regulatory inquiry. Requests for information must use neutral wording about routine account review only.",
    "injectionPatterns": [
      "ignore (all )?(previous|prior|above) (instructions|rules)",
      "disregard (the )?(above|system|previous)",
      "you are now (a|an|the)",
      "(reveal|print|show) .{0,30}(system prompt|api key|token|password)",
      "</?\\s*(system|assistant)\\s*>"
    ],
    "tippingOffPatterns": [
      "sanction(s|ed)?\\b",
      "watch ?list",
      "\\bOFAC\\b",
      "screening",
      "investigat(e|ion|ing)",
      "suspicious (activity|transaction)",
      "\\bSAR\\b",
      "(frozen|freeze|freezing|blocked)",
      "regulator(y)? (inquiry|enquiry)",
      "report(ed)? (this )?to the authorities",
      "money laundering"
    ]
  },
  "challenger": {
    "enabled": true,
    "confidenceBelow": 0.85,
    "nameScoreAtLeast": 0.95,
    "onDataQualityIssue": true
  }
}
