{
  "version": 9,
  "name": "Default screening policy",
  "description": "Baseline behaviour of the sanctions review desk. The jurisdiction list is a configurable example, not a complete or current list. Changes go through a reviewed, four-eyes publish.",
  "lists": {
    "enabled": ["OFAC", "UN"],
    "weights": {
      "OFAC": 1,
      "UN": 0.9,
      "EU": 0.9,
      "UK": 0.9
    }
  },
  "matching": {
    "nameSimilarityThreshold": 0.85,
    "autoCloseCeiling": 0.6,
    "strongIdentifierFields": ["dob", "nationality", "id_number", "passport_number"],
    "minStrongIdentifierMatches": 2
  },
  "ownership": {
    "thresholdPercent": 50,
    "aggregate": true,
    "maxChainDepth": 5,
    "onLimitReached": "escalate"
  },
  "jurisdictions": [
    {
      "country": "CU",
      "action": "escalate",
      "note": "Example entry. Verify against the current OFAC sanctions programs before relying on it; program status changes over time (for example Syria in 2025).",
      "keywords": ["Cuba", "Havana"]
    },
    {
      "country": "IR",
      "action": "escalate",
      "note": "Example entry. Verify against the current OFAC sanctions programs before relying on it; program status changes over time (for example Syria in 2025).",
      "keywords": ["Iran", "Tehran"]
    },
    {
      "country": "KP",
      "action": "escalate",
      "note": "Example entry. Verify against the current OFAC sanctions programs before relying on it; program status changes over time (for example Syria in 2025).",
      "keywords": ["North Korea", "DPRK", "Pyongyang"]
    }
  ],
  "automation": {
    "autoClose": true,
    "autoEscalate": true,
    "autoBlock": false,
    "messageCustomers": false,
    "dataAccess": "read_only",
    "blockApprovalsRequired": 2
  },
  "critic": {
    "maxRounds": 3,
    "confidenceFloorForClose": 0.7,
    "abstainOnInvalidData": true
  },
  "evidenceStandard": {
    "definition": "false_positive@2",
    "requireCheckReference": true,
    "requireDocumentNumber": true,
    "requireDate": true,
    "requireNamedCounterpartyForPayments": true
  },
  "autonomy": {
    "level": 0,
    "autoClose": {
      "confidenceAtLeast": 0.9,
      "qaSampleRate": 0.1,
      "dailyCap": 50
    },
    "escalationsAlwaysToPerson": true,
    "moreInfoAlwaysToPerson": true,
    "blockNeedsTwoApprovers": true
  },
  "screener": {
    "enabled": true,
    "confidenceThreshold": 0.5,
    "otherConfidenceThreshold": 0.7,
