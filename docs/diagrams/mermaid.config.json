    "actorBorder": "#22c55e",
    "actorTextColor": "#ffffff",
    "actorLineColor": "#7c8ba1",
    "signalColor": "#7c8ba1",
    "signalTextColor": "#7c8ba1",
    "labelBoxBkgColor": "#0b1f3a",
    "labelBoxBorderColor": "#22c55e",
    "labelTextColor": "#ffffff",
    "loopTextColor": "#7c8ba1",
    "noteBkgColor": "#14532d",
