{
  "name": "sanctions-desk",
  "version": "0.1.0",
  "private": true,
  "description": "AI review desk for bank sanctions screening alerts. A human always makes the final call.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sanctions-desk/api",
    "start": "npm run start -w @sanctions-desk/api",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "LIVE_TESTS=1 vitest run packages/shared/test/live packages/zetaris/test/live",
    "ci": "npm run typecheck && npm run lint && npm run lint:voice && npm run test:coverage",
    "verify": "uv run python scripts/verify_setup.py",
    "check:zetaris": "uv run python scripts/check_zetaris.py",
    "check:nemotron": "uv run python scripts/check_nemotron.py",
    "check:roles": "tsx tools/check-roles.ts",
    "check:isolation": "tsx tools/check-isolation.ts",
    "lint:voice": "node scripts/lint-voice.mjs",
    "scan:public": "node scripts/scan-public.mjs",
    "scan:history": "node scripts/scan-history.mjs",
    "receipt:pubkey": "tsx tools/receipt-pubkey.ts",
    "test:engines": "tsx tools/test-engines.ts",
    "zetaris:sql": "tsx tools/zetaris-sql.ts",
    "zetaris:generate": "tsx tools/generate-zetaris-sql.ts",
    "sample:record": "tsx tools/record-sample-cache.ts",
    "bankdb:schema": "tsx tools/generate-bankdb.ts",
    "bankdb:reset": "docker compose --env-file .env.data --profile data rm -sf bankdb payments-api && docker volume rm -f sanctions-desk_bankdb-data && docker compose --env-file .env.data --profile data up -d --build bankdb payments-api",
    "ledger": "tsx tools/model-ledger.ts",
    "exam": "tsx tools/run-exam.ts",
    "exam:alone": "tsx tools/nemotron-alone.ts",
    "exam:report": "tsx tools/exam-report.ts",
    "examples": "tsx tools/export-examples.ts",
    "citations": "tsx tools/citation-errors.ts",
    "json:rate": "tsx tools/json-failure-rate.ts",
    "evidence:export": "tsx tools/evidence-export.ts",
    "evidence:verify": "tsx tools/evidence-verify.ts",
    "bench": "tsx tools/bench.ts",
    "explain": "tsx tools/explain-queries.ts",
    "docs:edge-cases": "tsx tools/generate-edge-cases.ts",
    "zetaris:load-files": "tsx tools/zetaris-load-files.ts",
    "zetaris:agents": "tsx tools/zetaris-agents.ts",
    "zetaris:rebuild": "tsx tools/zetaris-rebuild.ts",
    "zetaris:definitions": "tsx tools/zetaris-definitions.ts",
    "adversarial:guard": "tsx tools/adversarial-guard.ts",
    "readme:refresh": "tsx tools/readme-facts.ts",
    "zetaris:cache-check": "tsx tools/zetaris-cache-check.ts",
    "lab:pinning": "tsx tools/pinning-lab.ts",
    "zetaris:queries": "tsx tools/zetaris-queries.ts",
    "zetaris:usl": "tsx tools/zetaris-usl.ts",
    "compare:hand-coded": "sh compare/hand-coded/run.sh",
    "usl:policy": "tsx tools/usl-policy.ts",
    "heldout:load": "tsx tools/heldout-load.ts",
    "heldout2:load": "tsx tools/heldout2-load.ts",
    "screenshots": "tsx tools/screenshots.ts",
    "mcp": "tsx tools/mcp-server.ts",
    "study:models": "tsx tools/model-study.ts",
    "bench:api": "tsx tools/load-test.ts",
    "lab:routing": "tsx tools/nightshift-lab.ts",
    "users:add": "tsx tools/users-add.ts",
    "actions:keygen": "tsx tools/actions-keygen.ts",
    "data:fetch": "tsx data/scripts/fetch.ts",
    "data:normalise": "tsx data/scripts/normalise.ts",
    "data:diff": "tsx data/scripts/diff.ts",
    "data:gleif": "tsx data/scripts/gleif.ts",
    "data:sample": "tsx data/scripts/sample.ts",
    "data:synthetic": "tsx data/scripts/synthetic.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
