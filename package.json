{
  "name": "sanctions-desk",
  "version": "0.1.0",
  "private": true,
  "description": "AI review desk for bank sanctions screening alerts. A human always makes the final call.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sanctions-desk/api",
    "start": "npm run start -w @sanctions-desk/api",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:live": "LIVE_TESTS=1 vitest run packages/shared/test/live",
    "verify": "uv run python scripts/verify_setup.py",
    "check:zetaris": "uv run python scripts/check_zetaris.py",
    "check:nemotron": "uv run python scripts/check_nemotron.py"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
